# --- secrets: the repo is public ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# --- data files: never committed ------------------------------------------
# Parquet goes to R2 or GitHub Releases via the manifest. The repo holds code
# and SQL only. The one exception is small parser fixtures under
# tests/fixtures/, which are force-added deliberately.
*.zip
*.parquet
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.csv
*.txt.gz
*.tsv
data/
!tests/fixtures/**

# --- checkpoints and run state --------------------------------------------
.checkpoints/
*.checkpoint.json

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- node: test support only ----------------------------------------------
# jsdom, so the suite can run the dashboard's inline script in a real DOM.
# package.json and package-lock.json are committed; the tree is not. Nothing
# in src/ touches node and neither data job does -- the dashboard has no build
# step and ships as one file. The only workflow that installs it is tests.yml,
# which runs the suite.
node_modules/

# --- editors and os -------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Rendered decks. **Six of these were committed in 3083eb8 and are in the
# history.** A deck's price page is 2,688 sessions of raw Tiingo OHLCV and its
# fundamentals page is XBRL, so a deck is vendor data in a portable file --
# exactly what the R2 boundary exists for, and a public repo makes a committed
# one redistribution. `mr decks --promoted` writes 27 a night (186 promoted, 27
# with a valuation to draw -- measured 2026-09-11), which would have turned one
# licensing mistake into a recurring one.
#
# "about forty a night" stood here until 2026-09-16 and was wrong twice over:
# the measured figure is 27 in both docs/operating.md and docs/build-spec.md,
# and *nothing was writing any of them* -- scripts/run_decks.cmd existed and
# the schtasks line was in the docs, but the task had never been registered,
# so .decks/run.log did not exist and the only decks on disk came from one
# hand-run. A rate in a comment is not a scheduler; see docs/operating.md for
# where the schedule actually lives.
.decks/
*.pptx

# Dashboard output. The screens are computed from Tiingo prices, so the
# rendered file is vendor data in browsable form -- never committed, never
# published, never a Release asset. Same boundary that put prices in R2.
# See docs/build-spec.md, "The UI track".
.dashboard/
dashboard.html
.cache/
