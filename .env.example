# Market Radar — environment template
#
# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored (.gitignore:2) and must never be committed. In GitHub
# Actions these come from Actions secrets instead, under the same names.
#
# Every value below is a dummy placeholder. Replace the ones you need; leave
# the rest alone until the weekend that uses them. Nothing here is required
# for `uv run pytest` — the suite runs with no credentials at all, by design.
#
# Grouped by build stage, so you can stop filling in once you reach the
# weekend you have not built yet. See docs/build-spec.md §5 for the order.
#
# CAUTION: MR_SUPABASE_SERVICE_KEY and MR_GITHUB_TOKEN are the two values
# here that can do real damage if leaked. Both are full-privilege.


# ==========================================================================
# 0. General
# ==========================================================================

# Which environment this process is running in. Used to pick safe defaults
# and to label rows written to Supabase. One of: dev | ci | prod
MR_ENV=dev

# Override the manifest location. Normally unset — manifest.py finds
# manifest.toml by walking up from the working directory. Set it to point at
# a scratch manifest without touching the committed one.
# MR_MANIFEST_OVERRIDE=/path/to/manifest.toml


# ==========================================================================
# 1. Weekend 1 — prices, storage, publishing
# ==========================================================================

# --- Cloudflare R2 --------------------------------------------------------
# Holds all vendor-derived Parquet. Private bucket; never public, because
# publishing Tiingo-derived data would breach their personal-use terms.
# See the licensing rule in CLAUDE.md.
#
# Where: dash.cloudflare.com -> R2 -> Overview. The account ID is in the
# right-hand sidebar. For the key pair: R2 -> "Manage R2 API Tokens" ->
# "Create API Token", permission "Object Read & Write", scoped to the bucket
# below. The secret is shown exactly once — copy it before closing the page.

# 32 hex characters.
MR_R2_ACCOUNT_ID=dummy-account-id-32-hex-chars

# 32 hex characters.
MR_R2_ACCESS_KEY_ID=dummy-access-key-id

# 64 hex characters. Full write access to the bucket.
MR_R2_SECRET_ACCESS_KEY=dummy-secret-access-key

# Bucket name. Create it first: R2 -> "Create bucket". Keep it private.
MR_R2_BUCKET=market-radar

# --- Tiingo ---------------------------------------------------------------
# Source of record for prices and corporate actions. Power plan, $30/month.
# Limits: 10k req/hour, 100k req/day, ~110k unique symbols/month, 40 GB/month.
#
# Where: tiingo.com -> sign in -> Account -> API -> Token.
MR_TIINGO_API_KEY=dummy-tiingo-api-key

# --- GitHub ---------------------------------------------------------------
# Used to upload public-domain Parquet as Release assets, and by the Actions
# workflow. Vendor data never goes here — only SEC, DOL, FRED, USAspending.
#
# Where: github.com/settings/personal-access-tokens -> "Generate new token"
# (fine-grained). Repository access: only this repo. Permissions:
# "Contents: Read and write" — that is what Release asset upload needs.
# Inside Actions, prefer the automatic GITHUB_TOKEN over this PAT.
MR_GITHUB_TOKEN=dummy-github-pat

# owner/repo slug that owns the Releases. No URL, just the slug.
MR_GITHUB_REPO=your-username/market-radar

# --- SEC ------------------------------------------------------------------
# No signup and no key, but SEC requires a descriptive User-Agent with a real
# contact address, and blocks traffic without one. Stay under 10 req/sec.
# Replace the address below with your own before any SEC request is made.
#
# Where: sec.gov/os/webmaster-faq#developers
MR_SEC_USER_AGENT=Market Radar (dummy@example.com)

# --- Supabase Postgres ----------------------------------------------------
# Entities, signals, deals, job_queue, dataset_stats. Free tier, 500 MB.
# Note free projects pause after ~7 days idle; the nightly job keeps it warm.
#
# Where: supabase.com/dashboard -> your project -> Project Settings.

# Database -> "Connection string" -> URI. Use the Session pooler URI (port
# 6543) rather than the direct connection (5432) — Actions runners are IPv4
# and the direct host is IPv6-only on the free tier.
MR_POSTGRES_DSN=postgresql://postgres.dummyref:dummy-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Settings -> API -> "Project URL".
MR_SUPABASE_URL=https://dummy-project-ref.supabase.co

# Settings -> API -> "service_role" secret. Bypasses row-level security
# entirely. Treat it like a database password: never in a client, never in a
# log, never in a public repo.
MR_SUPABASE_SERVICE_KEY=dummy-supabase-service-role-key


# ==========================================================================
# 2. Weekend 2 — screens, identity, digest
# ==========================================================================

# --- FRED -----------------------------------------------------------------
# 10-year Treasury (risk-free rate) and ICE BofA credit spreads. Free,
# 120 req/min.
#
# Where: fred.stlouisfed.org/docs/api/api_key.html -> request an API key
# (needs a free stlouisfed.org account).
MR_FRED_API_KEY=dummy-fred-api-key

# --- Resend (daily digest email) ------------------------------------------
# The digest is the only thing this system sends, and it sends only to you.
# No outreach, ever — see the out-of-scope list in CLAUDE.md.
#
# Where: resend.com -> API Keys -> "Create API Key", permission "Sending
# access". Free tier covers far more than one email a day.
MR_RESEND_API_KEY=dummy-resend-api-key

# Sender. Must be on a domain you have verified in Resend, or use
# onboarding@resend.dev for testing before your domain is verified.
MR_DIGEST_FROM=radar@example.com

# Recipient. Your own address — this is a personal research tool.
MR_DIGEST_TO=you@example.com


# ==========================================================================
# 3. Weekend 3 — sentinels
# ==========================================================================

# --- Finnhub --------------------------------------------------------------
# Quote cross-check and ticker-tagged company news. Free tier, 60 req/min.
#
# Where: finnhub.io -> register -> Dashboard, key is shown on arrival.
MR_FINNHUB_API_KEY=dummy-finnhub-api-key

# GDELT needs no key and no account — the Document API is open. EDGAR RSS
# needs no key either, only MR_SEC_USER_AGENT above.


# ==========================================================================
# 4. Weekend 4 — private company data
# ==========================================================================

# --- SAM.gov / USAspending ------------------------------------------------
# Federal contract awards: real revenue figures for contractors.
#
# Where: sam.gov -> sign in -> Account Details -> "Request Public API Key".
# Issued through api.data.gov. USAspending itself needs no key; this is only
# for the SAM.gov entity endpoints.
MR_SAMGOV_API_KEY=dummy-samgov-api-key

# DOL Form 5500, FMCSA, OSHA, and EPA are all plain bulk downloads with no
# key and no account.


# ==========================================================================
# 5. Tier 2 — LLM routing
# ==========================================================================
# Routed by difficulty in llm/router.py. Cheap classification goes local or
# to Groq; the good model is only for decks and narrative analysis. The
# router falls through to the next provider on failure, so a missing key
# degrades the run rather than killing it — fill in as many as you want.

# --- Ollama (local, cheap tier) -------------------------------------------
# No key. Runs on your machine, so it costs nothing and has no quota.
# Where: ollama.com/download, then `ollama serve`.
MR_OLLAMA_HOST=http://localhost:11434

# --- Groq (cheap tier) ----------------------------------------------------
# Fast classification and extraction. Free tier limits vary per model.
# Where: console.groq.com/keys
MR_GROQ_API_KEY=dummy-groq-api-key

# --- Cerebras (mid tier) --------------------------------------------------
# Built for batch; generous daily token allowance on the free tier.
# Where: cloud.cerebras.ai -> API Keys
MR_CEREBRAS_API_KEY=dummy-cerebras-api-key

# --- Google AI Studio (good tier) -----------------------------------------
# Gemini Flash, for 10-page decks and narrative analysis. No card required.
# Note inputs may be used for training outside the EU/UK/EEA — do not send
# anything you would not want retained.
# Where: aistudio.google.com/apikey
MR_GOOGLE_AI_API_KEY=dummy-google-ai-studio-key


# ==========================================================================
# Not listed, deliberately
# ==========================================================================
# yfinance     — no key, and it must never run in Actions. Yahoo rate-limits
#                by IP and datacenter ranges get flagged. Local only.
#                See the hard rule in CLAUDE.md.
# Stooq        — no key. Bulk archive is a manual CAPTCHA download; the files
#                are a parser fixture and a cross-check, not a live source.
# GDELT        — no key.
# DOL / FMCSA / OSHA / EPA — plain bulk files, no key.
