# Copy to .env and fill in. .env is gitignored and must never be committed.
# In CI these come from GitHub Actions secrets instead.
#
# Every value below is a dummy placeholder. The pre-commit hook recognises
# them and will not block this file — but it WILL block a real-looking
# credential anywhere else.

# --- Cloudflare R2: vendor-derived Parquet (private) ----------------------
MR_R2_ACCOUNT_ID=dummy-account-id
MR_R2_ACCESS_KEY_ID=dummy-access-key-id
MR_R2_SECRET_ACCESS_KEY=dummy-secret-access-key
MR_R2_BUCKET=market-radar

# --- Supabase Postgres: entities, signals, queue, dataset_stats -----------
MR_POSTGRES_DSN=postgresql://dummy:dummy@localhost:5432/postgres

# --- Tiingo: source of record for prices and corporate actions ------------
MR_TIINGO_API_KEY=dummy-tiingo-key

# --- SEC: required, must be a real contact address in real use ------------
MR_SEC_USER_AGENT=Market Radar (dummy@example.com)

# --- optional overrides ---------------------------------------------------
# Point the manifest somewhere else, for tests or a scratch dataset.
# MR_MANIFEST_OVERRIDE=/path/to/manifest.toml
